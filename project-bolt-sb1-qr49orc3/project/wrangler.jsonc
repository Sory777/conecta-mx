{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "conecta-mx",
  "compatibility_date": "2026-08-10",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "conectamxapp.uk", "custom_domain": true },
    { "pattern": "www.conectamxapp.uk", "custom_domain": true }
  ]
}