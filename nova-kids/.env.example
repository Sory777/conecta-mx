# ============================================================
# NOVA KIDS — variables de entorno
# Copia este archivo a .env.local y completa los valores.
# Nunca subas .env.local al repositorio.
# ============================================================

# URL pública de la tienda (se usa para SEO, Open Graph y retornos de pago)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Panel administrativo ----------
# Contraseña para entrar a /admin y secreto para firmar la sesión (cadena aleatoria larga).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ---------- Datos ----------
# "local"    → guarda productos/pedidos en .data/ (desarrollo o servidor propio con disco)
# "supabase" → usa Supabase (recomendado en producción / Vercel)
DATA_PROVIDER=local

# Carga productos de demostración en el modo local cuando el almacén está vacío.
# Ponlo en "false" cuando empieces a cargar tus productos reales.
SEED_DEMO_DATA=true

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca la expongas con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# ---------- Pagos (cada método se activa solo si tiene sus claves) ----------
# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" o "live"
PAYPAL_ENV=sandbox

# Transferencia bancaria (se activa si hay CLABE)
BANK_TRANSFER_BANK=
BANK_TRANSFER_HOLDER=
BANK_TRANSFER_CLABE=
