# ── Sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (sin estas variables la app usa el conjunto demostrativo en memoria)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sólo servidor (cron de literatura, eliminación de cuentas). NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── IA (opcional). Sin clave, HerbaAI funciona en modo extractivo (sin generación).
AI_PROVIDER=anthropic          # anthropic | none
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ── Identificación por imagen (opcional)
IDENTIFY_PROVIDER=anthropic    # anthropic | plantnet | none
PLANTNET_API_KEY=

# ── Fuentes científicas
NCBI_API_KEY=                  # opcional: eleva el límite de PubMed de 3 a 10 req/s
NCBI_EMAIL=                    # recomendado por NCBI para identificar la herramienta

# ── Operación
CRON_SECRET=                   # protege /api/cron/literature
PREMIUM_ENFORCED=false         # true para exigir plan premium en funciones avanzadas
