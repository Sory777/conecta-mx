# ===== Passive Income Agent Hub — configuración =====
# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.

# --- Seguridad (OBLIGATORIO en producción) ---
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto-por-un-valor-aleatorio-largo
# Permitir registro de nuevos usuarios después del primero (true/false)
ALLOW_REGISTRATION=false
# true si sirves la app detrás de HTTPS (cookies Secure)
COOKIE_SECURE=false

# --- Base de datos ---
DATABASE_URL=sqlite:///./data/hub.db

# --- Proveedores de IA / búsqueda (opcionales) ---
# Claude: habilita búsqueda web del Agente Investigador y extracción estructurada
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Brave Search API: alternativa de búsqueda sin LLM (solo guarda resultados)
BRAVE_API_KEY=
# CoinGecko (clave demo gratuita, opcional; mejora límites de uso)
COINGECKO_DEMO_API_KEY=

# --- Límites de uso ---
MAX_AGENT_RUNS_PER_DAY=30
RATE_LIMIT_PER_MINUTE=120

# --- Agentes continuos (desactivados por defecto: consumen API) ---
SCHEDULER_ENABLED=false
MONITOR_INTERVAL_HOURS=24
RESEARCH_INTERVAL_HOURS=72
# Consultas que el Agente de Investigación Continua ejecuta periódicamente (separadas por |)
RESEARCH_DEFAULT_QUERIES=plataformas de microtareas que acepten usuarios de México|proyectos DePIN activos con recompensas retirables
