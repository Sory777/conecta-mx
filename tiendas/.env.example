# Copia este archivo a .env y ajusta los valores.
PORT=3000
BASE_URL=http://localhost:3000
# Contraseña del panel central (/admin). Obligatoria.
ADMIN_PASSWORD=cambia-esta-contraseña
# Cadena aleatoria larga y fija (firma sesiones y enlaces de pedidos). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Ponlo en 1 si el servidor está detrás de un proxy/balanceador (Render, Railway, Nginx…)
# TRUST_PROXY=1

# Proveedor: mock (demo) | cj (CJ Dropshipping)
SUPPLIER=mock
CJ_API_KEY=
CJ_LOGISTIC=CJPacket Ordinary
# Palabras clave por categoría para importar de CJ
CJ_KEYWORDS=gadgets:wireless earbuds,smart watch,phone holder;ropa:hoodie,t-shirt,dress;accesorios:sunglasses,backpack,wallet
USD_TO_MXN=18.5

# Pagos: mock (demo, sin cobro real) | stripe
PAYMENTS=mock
STRIPE_SECRET_KEY=
# Comisión estimada de tu procesador de pagos (para calcular la ganancia neta)
PAYMENT_FEE_PCT=3.6
PAYMENT_FEE_FIXED_MXN=3

# Minutos entre sincronizaciones automáticas (0 = desactivar)
SYNC_EVERY_MINUTES=360
TRACKING_EVERY_MINUTES=60
