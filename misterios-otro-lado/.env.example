# =====================================================================
# Misterios: El Otro Lado — variables de entorno del SERVIDOR
# Copia este archivo a `.env` (o define las variables en tu plataforma).
# NUNCA subas `.env` al repositorio. El cliente NO usa secretos.
# =====================================================================

# development | production | test
NODE_ENV=development
HOST=0.0.0.0
PORT=8787

# Ruta del archivo SQLite (se crea automáticamente).
DATABASE_PATH=./data/misterios.db

# Secreto del servidor (HMAC de dispositivos, etc.). OBLIGATORIO en producción.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# En desarrollo, si falta, se genera y guarda en data/.dev-server-secret.
SERVER_SECRET=

# URL pública del cliente (para enlaces de verificación / recuperación de contraseña).
PUBLIC_BASE_URL=http://localhost:5173

# Duración de la sesión en horas (por defecto 30 días).
SESSION_TTL_HOURS=720

# true si el servidor está detrás de un proxy/balanceador (para leer la IP real).
TRUST_PROXY=false

# Intentos de autenticación por IP cada 10 minutos.
AUTH_RATE_PER_10MIN=20

# ---------------------------------------------------------------------
# SANDBOX / DINERO REAL
# ---------------------------------------------------------------------
# Modo sandbox: pagos, anuncios y canjes SIMULADOS y rotulados como tales.
SANDBOX_MODE=true
# Candado duro para canjes de puntos por valor real. Aunque el admin lo active
# en el panel, NO se permiten si esto es false o si SANDBOX_MODE=true.
REAL_PAYOUTS_ALLOWED=false

# Proveedor de pagos: sandbox | none
# (Google Play Billing / App Store / Stripe aún no están integrados: ver README.)
PAYMENT_PROVIDER=sandbox
# Proveedor de anuncios: sandbox | none  (AdMob SSV pendiente: ver README.)
AD_PROVIDER=sandbox
# Correo: console (imprime el enlace en el log, sólo desarrollo) | none
MAIL_PROVIDER=console

LOG_LEVEL=info

# ---------------------------------------------------------------------
# TELEGRAM MINI APP (ver MONETIZATION.md)
# ---------------------------------------------------------------------
# Token de @BotFather. Vacío = integración con Telegram desactivada.
TELEGRAM_BOT_TOKEN=
# Usuario del bot sin @ y nombre corto de la Mini App (/newapp en BotFather).
TELEGRAM_BOT_USERNAME=
TELEGRAM_APP_SHORT_NAME=
# URL HTTPS pública donde se sirve el juego (para el botón de menú del bot).
TELEGRAM_WEBAPP_URL=
# off | polling | webhook   (webhook requiere HTTPS público)
TELEGRAM_UPDATES=off
# Secreto para el header x-telegram-bot-api-secret-token del webhook.
TELEGRAM_WEBHOOK_SECRET=
# Antigüedad máxima aceptada del initData, en segundos.
TELEGRAM_INITDATA_MAX_AGE_SEC=86400
# Cobros REALES con Telegram Stars. Déjalo en false hasta probarlo.
TELEGRAM_STARS_ENABLED=false

# ---------------------------------------------------------------------
# ANUNCIOS (Adsgram / Monetag / AdSense H5 se configuran en el panel admin)
# ---------------------------------------------------------------------
# Secreto para firmar las URLs de callback servidor-a-servidor de cada red.
ADS_CALLBACK_SECRET=
