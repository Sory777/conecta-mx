{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cursoai",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cursoai",
      // Replace with the id printed by `npx wrangler d1 create cursoai` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Production defaults. Local overrides live in .dev.vars (see .dev.vars.example).
  // Secrets (ANTHROPIC_API_KEY) are set with `npx wrangler secret put ANTHROPIC_API_KEY`.
  "vars": {
    "ENVIRONMENT": "production",
    "AI_PROVIDER": "anthropic",
    "MODEL_FAST": "claude-haiku-4-5",
    "MODEL_STANDARD": "claude-sonnet-5",
    "MODEL_DEEP": "claude-opus-5",
    "AI_DAILY_BUDGET_USD": "25",
    "AI_RATE_PER_MIN": "20"
  }
}
